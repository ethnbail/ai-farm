# Run `python3 infra/init_env.py` to create a private .env with local credentials.
# Placeholder values only; do not put actual credentials in this file.
POSTGRES_USER=ai_farm
POSTGRES_DB=ai_farm
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DATABASE_URL=postgresql+psycopg://ai_farm:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/ai_farm
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AGENT_A_STARTING_BALANCE=1000.00
AGENT_B_STARTING_BALANCE=1000.00
HEARTBEAT_INTERVAL_SECONDS=5

# Phase 2: simulated execution only. Non-paper modes always fail closed.
TRADING_MODE=paper
MARKET_DATA_PROVIDER=mock
PAPER_WORKER_ENABLED=false
ENABLE_DEVELOPMENT_ACTIONS=false
REGULAR_HOURS_ONLY=true
QUOTE_MAX_AGE_SECONDS=60
EQUITY_SCAN_INTERVAL_SECONDS=60
OPTIONS_SCAN_INTERVAL_SECONDS=60
POSITION_MONITOR_INTERVAL_SECONDS=15
MAX_RISK_PER_TRADE_PERCENT=2
MAX_POSITION_SIZE_PERCENT=20
MAX_OPEN_POSITIONS=3
MAX_OPTIONS_POSITIONS=2
MAX_DAILY_LOSS_PERCENT=5
MAX_WEEKLY_LOSS_PERCENT=10
MAX_TOTAL_EXPOSURE_PERCENT=60
MIN_CASH_RESERVE_PERCENT=10
MAX_OPTION_PREMIUM_AT_RISK_PERCENT=2
MIN_OPTION_DTE=7
MAX_OPTION_DTE=45
MIN_OPTION_VOLUME=50
MIN_OPTION_OPEN_INTEREST=100
MAX_OPTION_SPREAD_PERCENT=15
TARGET_OPTION_DELTA_MIN=0.40
TARGET_OPTION_DELTA_MAX=0.70
# IV is a fraction (3 means 300%); theta decay is abs(theta) / ask * 100.
MAX_OPTION_IV=3
MAX_OPTION_THETA_DECAY_PERCENT=20
EQUITY_SLIPPAGE_BPS=5
OPTION_SLIPPAGE_PERCENT=1
STRATEGY_FAST_WINDOW=5
STRATEGY_SLOW_WINDOW=20
EQUITY_STOP_PERCENT=2
EQUITY_TARGET_PERCENT=4
OPTION_STOP_PERCENT=30
OPTION_TARGET_PERCENT=50
MINIMUM_PERFORMANCE_TRADES=5

# This is the ONLY browser-visible setting. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_3D_FARM=true
NEXT_PUBLIC_REDUCED_SCENE=false

# Phase 3. All keys remain backend-only. Disabled AI makes zero paid calls.
OPENAI_API_KEY=
AI_ENABLED=false
AI_MONTHLY_BUDGET_USD=10
AI_DAILY_BUDGET_USD=1
AI_CHEAP_MODEL=
AI_REASONING_MODEL=
AI_SHADOW_MODEL=
# Required verified USD-per-million input/output price ceilings for every enabled model.
# Example shape only: {"your-model-id":{"input":"1","output":"2"}}
AI_MODEL_PRICES={}
AI_MAX_CALLS_PER_SCAN=4
AI_MAX_CALLS_PER_DAY=30
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_CONTEXT_BYTES=16000
AI_PRIORITY_RESERVE_PERCENT=10
AI_TIMEOUT_SECONDS=15
# Scheduler keeps Phase 2 behavior until explicitly opted in.
INTELLIGENCE_ENABLED=false
AGENT_A_UNIVERSE=["SPY","QQQ","NVDA"]
AGENT_B_UNIVERSE=["SPY","FARM"]
# FARM is a synthetic mock fixture; replace with real underlyings for live data.
OPPORTUNITY_TOP_K=3
OPPORTUNITY_TTL_SECONDS=300
OPPORTUNITY_MIN_SCORE=50
# MARKET_DATA_PROVIDER above accepts mock or tradier; missing Tradier key -> explicit MOCK.
MARKET_DATA_API_KEY=
MARKET_TIMEOUT_SECONDS=5
MARKET_RETRIES=1
MARKET_MAX_REQUESTS_PER_SCAN=30
MARKET_MAX_CHAIN_EXPIRATIONS=2
EVENT_DATA_PROVIDER=unavailable
EVENT_DATA_API_KEY=
BLOCK_HIGH_IMPACT_EVENTS=true
EVENT_BLOCK_WINDOW_MINUTES=60
REQUIRE_EVENT_COVERAGE=false
MARKETPLACE_MODE=manual
MARKETPLACE_DEFAULT_ZIP=
MARKETPLACE_DEFAULT_RADIUS_MILES=25
MARKETPLACE_MIN_EXPECTED_PROFIT=25
MARKETPLACE_MIN_ROI_PERCENT=20
MARKETPLACE_MAX_PICKUP_MILES=30
MARKETPLACE_COST_PER_MILE=0.70
MARKETPLACE_FRESH_MINUTES=60
MARKETPLACE_RECENT_HOURS=24
MARKETPLACE_STRONG_SCORE_THRESHOLD=75
# Reserved for optional explanation providers; deterministic Marketplace analysis makes no AI calls.
MARKETPLACE_AI_ENABLED=false
# Watchlist mutation endpoints require this plus a trusted Origin. Local use only.
LOCAL_WRITES_ENABLED=false
# Still unused: no external notifications are sent.
DISCORD_WEBHOOK_URL=
