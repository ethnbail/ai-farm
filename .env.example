# Run `python3 infra/init_env.py` to create a private .env with local credentials.
# Placeholder values only; do not put actual credentials in this file.
POSTGRES_USER=ai_farm
POSTGRES_DB=ai_farm
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DATABASE_URL=postgresql+psycopg://ai_farm:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/ai_farm
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AGENT_A_STARTING_BALANCE=1000.00
AGENT_B_STARTING_BALANCE=1000.00
HEARTBEAT_INTERVAL_SECONDS=5

# Phase 2: simulated execution only. Non-paper modes always fail closed.
TRADING_MODE=paper
MARKET_DATA_PROVIDER=mock
PAPER_WORKER_ENABLED=false
ENABLE_DEVELOPMENT_ACTIONS=false
REGULAR_HOURS_ONLY=true
QUOTE_MAX_AGE_SECONDS=60
EQUITY_SCAN_INTERVAL_SECONDS=60
OPTIONS_SCAN_INTERVAL_SECONDS=60
POSITION_MONITOR_INTERVAL_SECONDS=15
MAX_RISK_PER_TRADE_PERCENT=2
MAX_POSITION_SIZE_PERCENT=20
MAX_OPEN_POSITIONS=3
MAX_OPTIONS_POSITIONS=2
MAX_DAILY_LOSS_PERCENT=5
MAX_WEEKLY_LOSS_PERCENT=10
MAX_TOTAL_EXPOSURE_PERCENT=60
MIN_CASH_RESERVE_PERCENT=10
MAX_OPTION_PREMIUM_AT_RISK_PERCENT=2
MIN_OPTION_DTE=7
MAX_OPTION_DTE=45
MIN_OPTION_VOLUME=50
MIN_OPTION_OPEN_INTEREST=100
MAX_OPTION_SPREAD_PERCENT=15
TARGET_OPTION_DELTA_MIN=0.40
TARGET_OPTION_DELTA_MAX=0.70
# IV is a fraction (3 means 300%); theta decay is abs(theta) / ask * 100.
MAX_OPTION_IV=3
MAX_OPTION_THETA_DECAY_PERCENT=20
EQUITY_SLIPPAGE_BPS=5
OPTION_SLIPPAGE_PERCENT=1
STRATEGY_FAST_WINDOW=5
STRATEGY_SLOW_WINDOW=20
EQUITY_STOP_PERCENT=2
EQUITY_TARGET_PERCENT=4
OPTION_STOP_PERCENT=30
OPTION_TARGET_PERCENT=50
MINIMUM_PERFORMANCE_TRADES=5

# This is the ONLY browser-visible setting. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reserved for future phases. Leave blank; Phase 2 does not call these services.
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=
MARKET_DATA_API_KEY=
DISCORD_WEBHOOK_URL=
