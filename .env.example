# Run `python3 infra/init_env.py` to create a private .env with local credentials.
# Placeholder values only; do not put actual credentials in this file.
POSTGRES_USER=ai_farm
POSTGRES_DB=ai_farm
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DATABASE_URL=postgresql+psycopg://ai_farm:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/ai_farm
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AGENT_A_STARTING_BALANCE=1000.00
AGENT_B_STARTING_BALANCE=1000.00
HEARTBEAT_INTERVAL_SECONDS=5

# This is the ONLY browser-visible setting. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reserved for future phases. Leave blank; Phase 1 does not call these services.
OPENAI_API_KEY=
AI_MONTHLY_BUDGET_USD=
MARKET_DATA_API_KEY=
DISCORD_WEBHOOK_URL=
